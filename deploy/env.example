# ~/.config/tts-suite/env — read by the service (EnvironmentFile); keep it private (chmod 600).
# The key of DashScope (cloud engine). Left empty here: put your own in the real file, never in the repository.
DASHSCOPE_API_KEY=
# The SSH key the suite uses to start containers on another machine (default: ~/.ssh/tts_suite_host).
TTS_SUITE_SSH_KEY=/home/user/.ssh/tts_suite_host

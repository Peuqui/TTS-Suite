// TTS-Suite: the user @SERVICE_USER@ (and with it AIfred, which asks the service to start) may start,
// stop and restart tts-suite@@SERVICE_USER@ without a password.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "tts-suite@@SERVICE_USER@.service" &&
        subject.user == "@SERVICE_USER@") {
        return polkit.Result.YES;
    }
});
